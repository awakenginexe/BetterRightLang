<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.5</Version>
    <Product>BetterRightLang</Product>
    <Description>Thai and English keyboard layout correction for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BetterRightLang.Desktop.Tests" />
    <ProjectReference Include="..\Core\BetterRightLang.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" />
    <Content Include="Web\**\*;Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Data\**\*" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LICENSE;..\README.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)\LICENSE.txt;$(PkgMicrosoft_Web_WebView2)\NOTICE.txt" Link="Notices\WebView2-%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
