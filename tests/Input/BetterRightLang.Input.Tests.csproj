<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/BetterRightLang.Core.csproj" />
    <Compile Include="../../Desktop/Input/*.cs" Link="Input/%(Filename)%(Extension)" />
    <Compile Include="../../Desktop/CorrectionMode.cs" Link="CorrectionMode.cs" />
  </ItemGroup>
</Project>
